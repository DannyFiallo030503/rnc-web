# Export these variables in the service environment; .env is not loaded automatically.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Set a unique secret before any shared deployment.
# DJANGO_SECRET_KEY=
RNC_PUBLIC_ORIGIN=http://127.0.0.1:8010
# Local private mailbox; no messages are delivered to real recipients.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
# To enable real mail, configure an authorized SMTP service:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_USE_TLS=1
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=
# RNC_PRIVATE_STORAGE=/absolute/private/path
