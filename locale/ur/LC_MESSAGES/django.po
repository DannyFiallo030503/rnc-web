#, fuzzy
msgid ""
"fuente y versión de la población, con cobertura territorial, edad y sexo."
msgstr "آبادی کا ذریعہ اور ورژن، بشمول علاقائی، عمر، اور جنسی کوریج۔"

#, fuzzy
msgid "unidad de análisis, escala, estándar de edad y forma de cálculo."
msgstr "تجزیہ کی اکائی، پیمانے، عمر کا معیار، اور حساب کتاب کا طریقہ۔"

#, fuzzy
msgid ""
"tasas calculadas con estándares, períodos, coberturas y definiciones "
"compatibles."
msgstr ""
"ہم آہنگ معیارات، ادوار، کوریج، اور تعریفوں کا استعمال کرتے ہوئے حساب کی گئی "
"شرح۔"

#, fuzzy
