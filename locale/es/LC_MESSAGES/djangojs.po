msgid "Check this box to continue."
msgstr "Marque esta casilla para continuar."

msgid "Complete this field."
msgstr "Complete este campo."

msgid "Check the characters entered in this field."
msgstr "Revise los caracteres introducidos en este campo."

msgid "Enter at least %(length)s characters."
msgstr "Use al menos %(length)s caracteres."

msgid "Enter no more than %(length)s characters."
msgstr "Use como máximo %(length)s caracteres."

msgid "Enter a valid email address, for example name@domain.com."
msgstr "Escriba un correo válido; por ejemplo, nombre@dominio.cu."

msgid "Choose a .csv file."
msgstr "Seleccione un archivo con extensión .csv."

msgid "The file exceeds the 12 MB limit."
msgstr "El archivo supera el límite de 12 MB."

msgid ""
"Separate name parts with a space, apostrophe, or hyphen; do not start or end"
" with punctuation."
msgstr ""
"Separe los nombres con un espacio, apóstrofo o guion; sin signos al comienzo"
" o al final."

msgid "The password cannot contain only numbers."
msgstr "La contraseña no puede contener solo números."

msgid "The passwords do not match. Enter the same password again."
msgstr "Las contraseñas no coinciden. Vuelva a escribir la misma contraseña."

msgid "Text was not added: enter no more than %(length)s characters."
msgstr "No se incorporó el texto: use como máximo %(length)s caracteres."

msgid "Disallowed text was not added. "
msgstr "No se incorporó el texto no permitido. "

msgid "Check the format of this field."
msgstr "Revise el formato de este campo."

msgid "No file selected"
msgstr "No se ha seleccionado un archivo"

msgid "All"
msgstr "Todos"

msgid "This chart does not support the selected dimension."
msgstr "Este gráfico no admite la dimensión seleccionada."

msgid "This chart does not support the selected indicator."
msgstr "Este gráfico no admite el indicador seleccionado."

msgid "This chart does not support the selected unit."
msgstr "Este gráfico no admite la unidad seleccionada."

msgid "For distinct people, compare composition by sex."
msgstr "Para personas distintas, compare la composición por sexo."

msgid "Line charts require comparison by period."
msgstr "Las líneas requieren comparar por período."

msgid "The series needs at least two years; clear the single-year selection."
msgstr ""
"La serie requiere al menos dos años; quite la selección de un solo año."

msgid "Point charts compare values by province of residence or age group."
msgstr ""
"Los gráficos de puntos comparan valores por provincia de residencia o grupo "
"de edad."

msgid ""
"This chart needs at least two categories; clear the single-province or "
"single-age filter."
msgstr ""
"Este gráfico necesita al menos dos categorías; quite el filtro de una sola "
"provincia/edad."

msgid "Scatter plots compare provinces or age groups."
msgstr "La dispersión compara provincias o grupos de edad."

msgid "Scatter plots compare absolute counts of tumors and distinct people."
msgstr ""
"La dispersión compara frecuencias absolutas de tumores y personas distintas."

msgid ""
"A scatter plot needs a selection where distinct people can be counted "
"without overlap."
msgstr ""
"La dispersión necesita una selección que permita contar personas distintas "
"sin solapamientos."

