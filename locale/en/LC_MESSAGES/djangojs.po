msgstr "Synthetic data"

msgid ""
"Deja un filtro sin selección para incluir todos sus valores; puedes elegir "
"varios."
msgstr ""
"Leave a filter empty to include all its values; you can select several."

msgid "Dimensión"
msgstr "Dimension"

msgid "El cálculo local encontró un error."
msgstr "The local calculation encountered an error."

msgid "El cálculo local se interrumpió."
msgstr "The local calculation was interrupted."

msgid "El navegador no ofrece una estimación de almacenamiento."
msgstr "This browser does not provide a storage estimate."

