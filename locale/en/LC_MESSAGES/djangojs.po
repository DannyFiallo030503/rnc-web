msgstr "The file exceeds the 12 MB limit."

msgid ""
"Separate name parts with a space, apostrophe, or hyphen; do not start or end"
" with punctuation."
msgstr ""
"Separate name parts with a space, apostrophe, or hyphen; do not start or end"
" with punctuation."

msgid "The password cannot contain only numbers."
msgstr "The password cannot contain only numbers."

msgid "The passwords do not match. Enter the same password again."
msgstr "The passwords do not match. Enter the same password again."

